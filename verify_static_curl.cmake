execute_process(COMMAND "${OBJDUMP}" -p "${BINARY}" OUTPUT_VARIABLE imports RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect Shader Studio library dependencies.")
endif()
string(TOLOWER "${imports}" imports)
if(imports MATCHES "(dll name:|needed)[^\n]*(libcurl|curl\\.dll)")
  message(FATAL_ERROR "Shader Studio has a dynamic libcurl dependency.")
endif()
message(STATUS "Verified: Shader Studio has no dynamic libcurl dependency.")
